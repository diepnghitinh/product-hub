# Root env for docker-compose. Copy to .env and edit — compose reads it
# automatically. Everything here has a safe local default, so this file is
# entirely optional; you only need it to change ports or add secrets.
#
#   cp .env.example .env

# Host port the app is served on → http://localhost:${WEB_PORT}
WEB_PORT=8080

# Host port the platform console is served on → http://localhost:${ADMIN_PORT}
# It stays a separate origin from the app on purpose (see saas-admin/README.md);
# in production put it on its own hostname, ideally behind a VPN or IP allowlist.
ADMIN_PORT=8081
# Where the console's "open workspace" links point. Empty hides them.
ADMIN_APP_URL=http://localhost:8080

# MongoDB credentials + database name
MONGO_USER=producthub
MONGO_PASSWORD=producthub
MONGO_DB=producthub

# API
NODE_ENV=production
JWT_SECRET=dev-secret-change-me      # CHANGE THIS for anything shared/online
JWT_EXPIRES_IN=7d
# Platform console tokens are signed with their own secret, so a workspace token
# can never be replayed against /v1/platform. CHANGE THIS too, to a DIFFERENT value.
PLATFORM_JWT_SECRET=dev-platform-secret-change-me
PLATFORM_JWT_EXPIRES_IN=12h
# Only relevant if you call the API cross-origin (both SPAs are same-origin).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Optional: Azure Blob storage for bug attachments.
# Leave empty to store attachments inline (base64) instead.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
