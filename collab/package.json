{
  "name": "product-hub-collab",
  "version": "1.0.0",
  "private": true,
  "description": "Yjs sync server (Hocuspocus) for real-time doc editing",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "sync": "tsx scripts/sync-shared.ts",
    "smoke": "tsx scripts/smoke-editorjs.ts",
    "verify": "tsx scripts/verify-sync.ts",
    "corpus": "tsx scripts/verify-corpus.ts",
    "typecheck": "tsx scripts/sync-shared.ts --check && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@blocknote/core": "^0.52.1",
    "@blocknote/server-util": "^0.52.1",
    "@hocuspocus/server": "^4.4.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.4.0",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
