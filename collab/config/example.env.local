# Local development template. Copy to config/.env.local (gitignored) and adjust.
# Mirrors backend/config/example.env.local — same convention, same values.

NODE_ENV=local
PORT=3002

# The Vite dev server. Only the /presence read needs this; WebSockets ignore CORS.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Must be the same database the API uses — this service mirrors rendered HTML
# back into the `docpages` collection the API owns.
MONGODB_URI=mongodb://producthub:producthub@localhost:27017/producthub?authSource=admin

# Must match backend JWT_SECRET byte for byte: editors authenticate here with
# the same access token they use for REST calls.
JWT_SECRET=dev-secret-change-me

# How long typing pauses before the Y.Doc is written to Mongo, and the ceiling
# that forces a write during continuous typing.
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=10000
