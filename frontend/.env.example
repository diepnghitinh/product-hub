# Base URL of the product-hub backend API (note the /v1 version prefix)
VITE_API_URL=http://localhost:3000/v1

# The Yjs sync server that powers collaborative doc editing (see collab/).
#
# The editor is the same either way — Editor.js, the one an issue's description
# uses. What this switches on is *sharing*: with it set, a doc page's body is a
# shared document (two carets, live merge, presence in the margin) and the body
# is saved by the sync server's HTML mirror rather than by the page's autosave.
#
# Leave it empty and doc pages work exactly like every other rich-text field in
# the app, with nothing extra to run.
#
# ./dev.sh starts the sync server alongside the API and the app when it's set.
VITE_COLLAB_URL=ws://localhost:3002
