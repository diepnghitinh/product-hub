# Production template. On the server, copy to config/.env.prod (gitignored) and
# set real secrets — never commit the filled-in file.

NODE_ENV=prod
PORT=3000
# Real web origin(s) — no localhost in production. Include the platform console's
# own origin; keeping it on a separate hostname is what stops a workspace user
# from ever loading that bundle.
ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
APP_BASE_URL=https://app.yourdomain.com
MAX_REQUEST_BODY_SIZE=10mb

# Use a long random secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=__set_a_strong_random_secret__
JWT_EXPIRES_IN=7d

# Platform console (/v1/platform) — a DIFFERENT random secret, so a workspace
# token can never be replayed against the vendor console.
PLATFORM_JWT_SECRET=__set_a_different_strong_random_secret__
PLATFORM_JWT_EXPIRES_IN=12h

# Managed MongoDB connection string.
MONGODB_URI=__set_production_mongodb_uri__
