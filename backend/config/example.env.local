# Local development template. Copy to config/.env.local (gitignored) and adjust.
# These are the safe local-dev defaults the stack ships with.

NODE_ENV=local
PORT=3000
# 3001 is the tenant app; 3003 is the platform console (saas-admin/).
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3003,http://127.0.0.1:3003
APP_BASE_URL=http://localhost:3001
# Public base URL of THIS API, used only to print the webhook URL in
# Settings → Integrations. Unset, the API uses the address the request arrived on
# — locally that's this port, which no git host can reach. Point it at a tunnel
# (ngrok/cloudflared) when you want to test real deliveries against your machine.
# API_BASE_URL=https://your-tunnel.ngrok-free.app
MAX_REQUEST_BODY_SIZE=10mb

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Platform-console tokens use their own secret. Unset it derives one from
# JWT_SECRET, which is enough locally.
PLATFORM_JWT_EXPIRES_IN=12h

MONGODB_URI=mongodb://producthub:producthub@localhost:27017/producthub?authSource=admin
